{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/client",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://acceleriamo-os.diego-faf.workers.dev/api/:path*"
    },
    {
      "source": "/r/:path*",
      "destination": "https://acceleriamo-os.diego-faf.workers.dev/r/:path*"
    },
    {
      "source": "/robots.txt",
      "destination": "https://acceleriamo-os.diego-faf.workers.dev/robots.txt"
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://acceleriamo-os.diego-faf.workers.dev/sitemap.xml"
    },
    {
      "source": "/assets/:path*",
      "destination": "https://acceleriamo-os.diego-faf.workers.dev/assets/:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
