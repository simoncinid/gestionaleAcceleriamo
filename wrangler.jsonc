{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "acceleriamo-os",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*", "/r/*", "/robots.txt", "/sitemap.xml"] },
  "d1_databases": [
    { "binding": "DB", "database_name": "acceleriamo-os", "database_id": "a974e4dd-129a-461d-9793-bd50b2aaf1b5", "migrations_dir": "drizzle" }
  ],
  // File dei documenti dei lead (spec 29/10/2026): mai pubblici, si leggono solo dal Worker con la sessione.
  "r2_buckets": [{ "binding": "DOCUMENTI", "bucket_name": "acceleriamo-os-documenti" }],
  "vars": {
    "META_GRAPH_VERSION": "v23.0",
    // Id della Pagina Facebook con i moduli dei lead (non è un segreto).
    // Senza id (o senza META_PAGE_TOKEN) il recupero dei lead risulta "spento" nella pagina Stato.
    "META_PAGE_ID": "1217893964750759",
    "IG_GRAPH_VERSION": "v25.0",
    // Chiave pubblica VAPID: vuota finché Tommaso non genera la coppia (README, Task 16). La privata è un segreto.
    "VAPID_PUBLIC_KEY": "",
    "VAPID_SOGGETTO": "https://risorse.acceleriamo.it",
    // Nome utente del bot di Telegram (senza @): vuoto finché Tommaso non crea il bot. Il token è un segreto.
    "TELEGRAM_BOT": "",
    // Indirizzo dell'app per i link nei messaggi di Telegram.
    "APP_URL": "https://risorse.acceleriamo.it",
    // Indirizzo dello spazio demo (Task 13), mostrato in Impostazioni > Dati.
    "DEMO_URL": "https://acceleriamo-os-demo.diego-faf.workers.dev"
  },
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": { "enabled": true },
  "env": {
    // Spazio demo (spec 12): stesso codice, database separato, nessun cron, nessun segreto.
    // Le vars non si ereditano: qui mancano apposta VAPID e bot Telegram, quindi push e Telegram restano spenti.
    "demo": {
      "name": "acceleriamo-os-demo",
      "d1_databases": [
        // database_id: id del database demo creato il 19/10/2026 su account diego@acceleriamo.it (non è un segreto).
        { "binding": "DB", "database_name": "acceleriamo-os-demo", "database_id": "4d356e6d-f9fb-4816-acc2-a5198ed4a8ab", "migrations_dir": "drizzle" }
      ],
      "r2_buckets": [{ "binding": "DOCUMENTI", "bucket_name": "acceleriamo-os-demo-documenti" }],
      "vars": { "META_GRAPH_VERSION": "v23.0", "IG_GRAPH_VERSION": "v25.0", "SPAZIO": "demo", "DEMO_URL": "", "APP_URL": "https://acceleriamo-os-demo.diego-faf.workers.dev" },
      "triggers": { "crons": [] }
    }
  }
}
