{
  "name": "acceleriamo-os",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "deploy": "vite build && wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply acceleriamo-os --local",
    "db:migrate:remote": "wrangler d1 migrations apply acceleriamo-os --remote",
    "db:migrate:demo": "wrangler d1 migrations apply acceleriamo-os-demo --env demo --remote",
    "db:migrate:demo:locale": "wrangler d1 migrations apply acceleriamo-os-demo --env demo --local",
    "demo:reset": "tsx scripts/seed-demo.ts --remote",
    "demo:locale": "tsx scripts/seed-demo.ts --local",
    "deploy:demo": "CLOUDFLARE_ENV=demo vite build && wrangler deploy",
    "e2e": "playwright test",
    "e2e:foto": "playwright test --update-snapshots"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-query": "^5.104.1",
    "drizzle-orm": "^0.44.7",
    "hono": "^4.13.13",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^7.18.4",
    "sonner": "^2.0.8",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.63.1",
    "@cloudflare/vitest-pool-workers": "^0.8.71",
    "@cloudflare/workers-types": "^5.20261008.1",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~5.8",
    "vite": "^6.4.4",
    "vitest": "~3.2.0",
    "wrangler": "^4.149.0"
  }
}
